{
  "name": "hintatutka",
  "version": "9.8.14",
  "description": "Zero-CLS Finnish & EU retail price intelligence overlay across 81 stores + Amazon.de landed cost, Tori/Vinted/Huuto flip arbitrage & club deal audit.",
  "type": "module",
  "scripts": {
    "test": "node --test \"tests/**/*.test.js\"",
    "test:guards": "node --test tests/guards.test.js",
    "test:precision": "node --test tests/precision.test.js",
    "test:invariants": "node --test tests/invariants.test.js",
    "test:stores": "node --test tests/stores.test.js",
    "test:categories": "node --test tests/categories.test.js",
    "test:fixtures": "node --test tests/fixtures.test.js",
    "test:priceability": "node --test tests/priceability.test.js",
    "test:parsers": "node --test tests/parsers.test.js",
    "test:algorithms": "node --test tests/algorithms.test.js",
    "test:cache": "node --test tests/cache.test.js",
    "test:realtime": "node tests/realtime.mjs",
    "test:realtime:live": "node tests/realtime.mjs --live",
    "verify": "node scripts/verify.mjs",
    "verify:quick": "node scripts/verify.mjs --quick",
    "build:zip": "node scripts/build-zip.mjs",
    "arbitrage": "node scripts/arbitrage-bot.mjs",
    "arbitrage:once": "node scripts/arbitrage-bot.mjs --once --mock",
    "suomi-lisa": "node scripts/suomi-lisa-tracker.mjs",
    "heal:selectors": "node scripts/heal-selectors.mjs --fix",
    "harvest": "node scripts/harvest-store.mjs",
    "build:docs": "node scripts/build-docs.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FIMARx/hintatutka.git"
  },
  "keywords": [
    "userscript",
    "chrome-extension",
    "price-comparison",
    "finland",
    "hinta",
    "amazon-de",
    "arbitrage"
  ],
